# Banco PostgreSQL (Neon, Supabase, Vercel Postgres, RDS...)
DATABASE_URL="postgresql://user:pass@host:5432/hotsecret"
# Opcional: cria as tabelas em um schema próprio (recomendado em bancos compartilhados, ex.: Supabase)
DB_SCHEMA=""

# Segredo para assinar sessões (gere com: openssl rand -base64 48)
AUTH_SECRET=""

# URL pública da aplicação (sem barra no final, sem o basePath)
APP_URL="https://seu-dominio.com"
NEXT_PUBLIC_BASE_PATH="/hot-secret"

# Primeiro administrador (usado pelo seed). Também é possível criar pela tela de login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Gateway de pagamento: "zuckpay", "mercadopago" ou "sandbox" (apenas testes)
PAYMENT_PROVIDER="sandbox"

# ZuckPay (painel ZuckPay > Desenvolvedores > Credenciais API / Webhook Secret)
ZUCKPAY_CLIENT_ID=""
ZUCKPAY_CLIENT_SECRET=""
ZUCKPAY_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo de assinatura dos webhooks (Mercado Pago > Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=""

# Zenith Payments API (produtos em MXN/ARS). Chaves só no servidor — nunca no navegador ou no repositório.
ZENITH_PUBLIC_KEY=""
ZENITH_SECRET_KEY=""
# "sandbox" (padrão) ou "production" (cobrança real)
ZENITH_ENVIRONMENT="sandbox"
# Gateway por moeda (fora do Brasil): "zenith"
PAYMENT_PROVIDER_MXN=""
PAYMENT_PROVIDER_ARS=""

# Dados do pagador enviados ao gateway (o visitante não preenche nada no checkout).
# Vazio = nome "Cliente Hot Secret" e um e-mail técnico gerado por pagamento.
CHECKOUT_PAYER_NAME=""
CHECKOUT_PAYER_EMAIL=""
CHECKOUT_PAYER_EMAIL_DOMAIN="hotsecret.app"
# A ZuckPay também exige CPF e telefone do pagador (use os dados do titular do SaaS)
CHECKOUT_PAYER_CPF=""
CHECKOUT_PAYER_PHONE=""

# Protege o endpoint de cron (/api/cron/recovery)
CRON_SECRET=""

# Opcional: uploads no Vercel Blob. Sem isso, arquivos vão para public/uploads (apenas servidor com disco persistente)
BLOB_READ_WRITE_TOKEN=""
